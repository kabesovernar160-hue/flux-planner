# Скопируйте в .env и заполните. Файл .env закрыт в .gitignore.
# Все переменные читаются только на сервере и никогда не попадают в бандл клиента.
# Проверка происходит при старте: без обязательных значений приложение
# не поднимется и скажет, чего не хватает.

# ─── Telegram ───────────────────────────────────────────────────────────────

# Токен бота от @BotFather. Нужен для проверки подписи initData, работы бота
# в чате и отправки уведомлений. Никогда не передавать в клиент.
TELEGRAM_BOT_TOKEN=

# Публичный адрес Mini App по HTTPS — его открывает кнопка в боте.
# Локально это адрес туннеля (npm run dev:tunnel), в продакшене — домен приложения.
# Telegram принимает только https, http-адрес будет отвергнут.
TELEGRAM_MINI_APP_URL=

# Секрет вебхука бота. Telegram присылает его в заголовке
# X-Telegram-Bot-Api-Secret-Token. Придумайте длинную случайную строку.
TELEGRAM_WEBHOOK_SECRET=

# Адрес приложения для служебных скриптов.
# npm run bot переотправляет сюда обновления, npm run bot:webhook регистрирует
# по нему вебхук. Локально достаточно http://localhost:5173.
APP_URL=http://localhost:5173

# ─── База данных ────────────────────────────────────────────────────────────

# Локально — файл: file:flux-planner.db
# На хостинге — удалённая база libSQL: libsql://имя-организация.turso.io
DATABASE_URL=file:flux-planner.db

# Токен доступа к удалённой базе. Для файловой не нужен.
DATABASE_AUTH_TOKEN=

# Подтверждение файловой базы в продакшене.
# Нужно только если приложение живёт на своём сервере с постоянным диском.
# На serverless-хостинге файл исчезает вместе с контейнером — там нужен libsql://.
ALLOW_FILE_DATABASE=

# ─── Распознавание еды ──────────────────────────────────────────────────────

# Ключ провайдера распознавания (Anthropic).
# Если пусто: в разработке работает детерминированный мок,
# в продакшене эндпоинт отвечает ошибкой конфигурации.
AI_API_KEY=

# ─── Прочее ─────────────────────────────────────────────────────────────────

# Секрет для защиты cron-эндпоинта ежедневной рассылки.
CRON_SECRET=

# Только для собранного сервера (node build):
# ORIGIN — внешний адрес приложения, нужен для защиты форм от CSRF.
# PORT — порт, который слушает сервер.
# ORIGIN=https://ваш-домен
# PORT=3000
